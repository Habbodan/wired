NODE_ENV=development
PORT=3000

# The URL people open in the browser. In development this is the Vite dev server.
APP_ORIGIN=http://localhost:5173

DATABASE_URL=mysql://wired:wired@localhost:3306/wired

# Number of reverse proxies in front of the app (Hostinger/Passenger: 1).
TRUST_PROXY=1
LOG_LEVEL=info
SESSION_TTL_DAYS=30

# 32 random bytes, base64. Generate each one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# DATA_ENCRYPTION_KEY encrypts saved Wired keys. Changing it makes saved keys unreadable.
DATA_ENCRYPTION_KEY=
OAUTH_STATE_KEY=

# OAuth client registered on habbodan.com. The redirect URI must be {APP_ORIGIN}/auth/callback.
HABBODAN_OAUTH_ISSUER=https://habbodan.com
HABBODAN_OAUTH_CLIENT_ID=
HABBODAN_OAUTH_CLIENT_SECRET=
