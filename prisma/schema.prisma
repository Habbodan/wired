generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id         String      @id @default(uuid()) @db.Char(36)
  habbodanId Int         @unique @map("habbodan_id")
  username   String      @db.VarChar(64)
  hotel      String      @db.VarChar(16)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  sessions   Session[]
  workspaces Workspace[]

  @@map("users")
}

model Session {
  tokenHash  String   @id @map("token_hash") @db.Char(64)
  userId     String   @map("user_id") @db.Char(36)
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Workspace {
  id        String   @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  name      String   @db.VarChar(48)
  hotel     String   @db.VarChar(16)
  roomId    BigInt   @map("room_id")
  readKey   String?  @map("read_key") @db.VarChar(512)
  writeKey  String?  @map("write_key") @db.VarChar(512)
  state     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@map("workspaces")
}
